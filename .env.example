# DICOM Ghost Hunter — Environment configuration example
# Copy this file to .env and adapt values for your local setup.
# Never commit real credentials or patient data.

# Application
APP_NAME=DICOM Ghost Hunter
APP_VERSION=0.1.0
APP_ENV=development

# Logging
LOG_LEVEL=INFO
LOG_FILE=data/logs/dicom_ghost_hunter.log

# Database (SQLite by default; prepared for future PostgreSQL migration)
DATABASE_URL=sqlite:///data/database/dicom_ghost_hunter.db

# Quality-control rules
QC_RULES_FILE=config/qc_rules.yaml

# Orthanc PACS integration (optional, Workflow B)
ORTHANC_HOST=http://localhost:8042
ORTHANC_USERNAME=
ORTHANC_PASSWORD=
ORTHANC_TIMEOUT=30
ORTHANC_VERIFY_SSL=false

# DICOMweb (optional)
DICOMWEB_BASE_URL=
DICOMWEB_USERNAME=
DICOMWEB_PASSWORD=

# Data retention (days)
DATA_RETENTION_DAYS=90

# UI
UI_THEME=dark
UI_MAX_RECENT_EXAMINATIONS=10
